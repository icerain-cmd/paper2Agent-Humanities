{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper2Agent-Humanities SourceEdition",
  "type": "object",
  "required": ["work_id", "edition_id", "version_label", "source_language", "publication_year", "canonical_source"],
  "properties": {
    "work_id": {"type": "string", "minLength": 1},
    "edition_id": {"type": "string", "minLength": 1},
    "version_label": {"type": "string", "minLength": 1},
    "source_language": {"type": "string", "minLength": 1},
    "publication_year": {"type": "integer", "minimum": 1},
    "source_page": {"type": ["integer", "null"], "minimum": 1},
    "canonical_source": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
